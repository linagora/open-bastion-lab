# dwho, rtyler, etc. uses their own identity file

Host bastion-1
    HostName 192.168.122.2
    IdentityFile "~/.ssh/id_%r"
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile "~/.ssh/known_hosts"

